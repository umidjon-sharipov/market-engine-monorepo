{
    "cli": {
        "version": ">= 25.0.0",
        "appVersionSource": "remote"
    },
    "build": {
        "development": {
            "developmentClient": true,
            "distribution": "internal"
        },
        "preview": {
            "distribution": "internal",
            "env": {
                "COREPACK_ENABLE_DOWNLOAD_PROMPT": "0"
            },
            "android": {
                "buildType": "apk"
            }
        },
        "production": {
            "autoIncrement": true,
            "env": {
                "COREPACK_ENABLE_DOWNLOAD_PROMPT": "0"
            },
            "android": {
                "buildType": "apk"
            }
        }
    }
}