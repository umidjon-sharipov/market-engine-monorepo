{
    "$schema": "https://json.schemastore.org/nest-cli",
    "collection": "@nestjs/schematics",
    "sourceRoot": "src",
    "compiler": "swc",
    "compilerOptions": {
        "deleteOutDir": true,
        "assets": [
            {
                "include": "../public/**/*",
                "outDir": "dist/public",
                "watchAssets": true
            }
        ]
    }
}