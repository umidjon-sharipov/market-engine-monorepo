generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  NEW
  PROCESSING
  CONFIRMED
  SHIPPED
  DELIVERED
  COMPLETED
  CANCELLED
}

enum MessageType {
  message
  system
  poll
  media
}

model Market {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @db.VarChar(255)
  title     String   @db.VarChar(255)
  logo      String   @db.Text
  lat       Float
  lng       Float
  createdAt DateTime @default(now()) @map("createdAt") @db.Timestamptz(6)

  products   Product[]
  sliders    Slider[]
  discounts  Discount[]
  workers    Worker[]
  vacancies  Vacancy[]
  warehouses Warehouse[]
  categories Category[]
  followers  Following[]

  @@index([email])
  @@map("Markets")
}

model User {
  id                  String    @id @default(uuid()) @db.Uuid
  email               String    @unique @db.VarChar(255)
  userName            String?   @unique @db.VarChar(100)
  firstName           String?   @db.VarChar(100)
  lastName            String?   @db.VarChar(100)
  phone               String?   @db.VarChar(20)
  gender              String?   @db.VarChar(20)
  bio                 String?   @db.Text
  image               String?   @db.Text
  isBlocked           Boolean   @default(false)
  blockReason         String?   @db.Text
  blockedUntil        DateTime? @db.Timestamptz(6)
  failedLoginAttempts Int       @default(0)
  createdAt           DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @db.Timestamptz(6)

  otps                UserOtp[]
  sessions            UserSession[]
  auditLogs           AuditLog[]
  workers             Worker[]
  comments            Comment[]
  groupMembers        GroupMember[]
  groupPermissions    GroupPermission[]
  groupMessages       GroupMessage[]
  pinnedGroupMessages GroupPin[]
  following           Following[]

  @@map("Users")
}

model UserOtp {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String?  @db.Uuid
  email        String   @db.VarChar(255)
  otpHash      String   @db.VarChar(255)
  expiresAt    DateTime @db.Timestamptz(6)
  attemptCount Int      @default(0)
  isUsed       Boolean  @default(false)
  ipAddress    String   @db.VarChar(45)
  userAgent    String?  @db.Text
  createdAt    DateTime @default(now()) @db.Timestamptz(6)

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email, isUsed, createdAt(sort: Desc)])
  @@index([userId])
  @@map("UserOtps")
}

model UserSession {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String?  @db.Uuid
  refreshTokenHash String   @db.VarChar(255)
  ipAddress        String   @db.VarChar(45)
  userAgent        String?  @db.Text
  isRevoked        Boolean  @default(false)
  expiresAt        DateTime @db.Timestamptz(6)
  createdAt        DateTime @default(now()) @db.Timestamptz(6)

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isRevoked, expiresAt])
  @@map("UserSessions")
}

model IpBlockList {
  id           String   @id @default(uuid()) @db.Uuid
  ipAddress    String   @unique @db.VarChar(45)
  attemptCount Int      @default(1)
  blockedUntil DateTime @db.Timestamptz(6)
  createdAt    DateTime @default(now()) @db.Timestamptz(6)

  @@map("IpBlockList")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @db.Uuid
  ipAddress String   @db.VarChar(45)
  action    String   @db.VarChar(100)
  details   Json?
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@map("AuditLogs")
}

model Follower {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Text
  following Json     @default("[]")
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([userId])
  @@map("Followers")
}

model Following {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  marketId    String   @db.Uuid
  isFollowing Boolean  @default(true)
  isBlocked   Boolean  @default(false)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  market Market @relation(fields: [marketId], references: [id], onDelete: Cascade)

  @@unique([userId, marketId])
  @@index([marketId, isFollowing])
  @@index([userId, isFollowing])
  @@map("Followings")
}

model Product {
  id          String          @id @default(uuid()) @db.Uuid
  title       String          @db.VarChar(255)
  description Json            @default("[]")
  price       Float           @default(0)
  gradient    Json            @default("[]")
  discountId  String?         @db.Uuid
  categoryId  String?         @db.Uuid
  options     ProductOption[]
  images      Json            @default("[]")
  quantity    Int             @default(0)
  marketId    String          @db.Uuid
  warehouseId String          @db.Uuid
  createdAt   DateTime        @default(now()) @db.Timestamptz(6)

  market    Market    @relation(fields: [marketId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  discount  Discount? @relation(fields: [discountId], references: [id], onDelete: SetNull)
  category  Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  comments  Comment[]

  @@index([marketId, createdAt(sort: Desc)])
  @@index([warehouseId])
  @@index([categoryId])
  @@index([discountId])
  @@map("Products")
}

model ProductOption {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @db.Uuid
  title     String   @db.VarChar(255)
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  product Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  items   ProductOptionItem[]

  @@index([productId])
  @@map("ProductOptions")
}

model ProductOptionItem {
  id       String @id @default(uuid()) @db.Uuid
  optionId String @db.Uuid
  key      String @db.VarChar(255)
  value    Float  @default(0)

  option ProductOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@index([optionId])
  @@map("ProductOptionItems")
}

model Slider {
  id        String   @id @default(uuid()) @db.Uuid
  image     String   @db.Text
  link      String   @db.Text
  marketId  String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  market Market @relation(fields: [marketId], references: [id], onDelete: Cascade)

  @@index([marketId, createdAt(sort: Desc)])
  @@map("Sliders")
}

model Discount {
  id         String   @id @default(uuid()) @db.Uuid
  title      String   @db.VarChar(255)
  percentage Float
  startDate  DateTime @db.Timestamptz(6)
  endDate    DateTime @db.Timestamptz(6)
  marketId   String   @map("marketId") @db.Uuid 
  createdAt  DateTime @default(now()) @db.Timestamptz(6)

  market   Market    @relation(fields: [marketId], references: [id], onDelete: Cascade)
  products Product[]

  @@index([marketId, startDate, endDate])
  @@map("Discounts")
}

model Order {
  id        String      @id @default(uuid()) @db.Uuid
  name      String      @db.VarChar(255)
  product   String      @db.Text
  phone     String      @db.VarChar(50)
  address   String      @db.Text
  items     Json        @default("[]")
  status    OrderStatus @default(NEW)
  createdAt DateTime    @default(now()) @db.Timestamptz(6)

  @@index([status, createdAt(sort: Desc)])
  @@map("Orders")
}

model FeatureRequest {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(255)
  phone     String   @db.VarChar(50)
  product   String   @db.Text
  title     String   @db.VarChar(255)
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([createdAt(sort: Desc)])
  @@map("FeatureRequests")
}

model Comment {
  id        String   @id @default(uuid()) @db.Uuid
  reply     String?  @db.Text
  rate      Int
  images    Json     @default("[]")
  userId    String   @map("user") @db.Uuid
  productId String   @db.Uuid
  comment   String   @db.VarChar(400)
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, createdAt(sort: Desc)])
  @@index([rate])
  @@map("Comments")
}

model Reaction {
  id        String   @id @default(uuid()) @db.Uuid
  reaction  String   @db.VarChar(50)
  product   String   @db.Text
  profile   String   @db.Text
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([product])
  @@map("Reactions")
}

model Worker {
  id        String   @id @default(uuid()) @db.Uuid
  marketId  String?  @db.Uuid
  userId    String   @db.Uuid
  role      String   @db.VarChar(50)
  salary    Decimal? @db.Decimal(12, 2)
  vacancyId String?  @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  market  Market?  @relation(fields: [marketId], references: [id], onDelete: Cascade)
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  vacancy Vacancy? @relation(fields: [vacancyId], references: [id], onDelete: SetNull)
  permissions String[]

  @@unique([marketId, userId, role])
  @@index([userId])
  @@index([vacancyId])
  @@map("Workers")
}

model Vacancy {
  id              String   @id @default(uuid()) @db.Uuid
  marketId        String?  @db.Uuid
  title           String   @db.VarChar(255)
  requiredRole    String   @map("requiredRole") @db.VarChar(50)
  jobType         String   @db.VarChar(50)
  requiredWorkers Int
  salary          Decimal? @db.Decimal(12, 2)
  image           String   @db.Text
  skills          String   @db.Text
  experience      String   @db.VarChar(60)
  description     String?  @db.Text
  benefits        String?  @db.Text
  hrName          String   @db.VarChar(255)
  hrPhone         String   @db.VarChar(50)
  hrLink          String?  @db.Text
  applicants      Json     @default("[]")
  createdAt       DateTime @default(now()) @db.Timestamptz(6)

  market  Market?  @relation(fields: [marketId], references: [id], onDelete: Cascade)
  workers Worker[]

  @@index([marketId, createdAt(sort: Desc)])
  @@map("Vacancies")
}

model Warehouse {
  id        String   @id @default(uuid()) @db.Uuid
  title     String   @db.VarChar(255)
  marketId  String   @db.Uuid
  lat       String   @db.VarChar(50)
  lng       String   @db.VarChar(50)
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  market   Market    @relation(fields: [marketId], references: [id], onDelete: Cascade)
  products Product[]

  @@index([marketId])
  @@map("Warehouses")
}

model Category {
  id        String   @id @default(uuid()) @db.Uuid
  marketId  String   @db.Uuid
  title     String   @db.VarChar(255)
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  market   Market           @relation(fields: [marketId], references: [id], onDelete: Cascade)
  products Product[]
  options  CategoryOption[]

  @@unique([marketId, title])
  @@index([marketId])
  @@map("Categories")
}

model CategoryOption {
  id         String   @id @default(uuid()) @db.Uuid
  categoryId String   @db.Uuid
  title      String   @db.VarChar(255)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)

  category Category             @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  items    CategoryOptionItem[]

  @@index([categoryId])
  @@map("CategoryOptions")
}

model CategoryOptionItem {
  id       String  @id @default(uuid()) @db.Uuid
  optionId String  @db.Uuid
  title    String  @db.VarChar(255)
  image    String? @db.Text

  option CategoryOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@index([optionId])
  @@map("CategoryOptionItems")
}

model Group {
  id            String   @id @default(uuid()) @db.Uuid
  url           String   @unique @default(uuid()) @db.VarChar(100)
  logo          String?  @db.Text
  securityLevel String   @db.VarChar(50)
  title         String   @db.VarChar(255)
  type          String   @db.VarChar(200)
  topics        Json     @default("[]")
  description   String?  @db.VarChar(150)
  founder       String   @db.Text
  defaults      Json     @default("{}")
  users         Json     @default("[]")
  limit         String?  @default("\\infty") @db.VarChar(20)
  createdAt     DateTime @default(now()) @db.Timestamptz(6)

  messages           Message[]
  members            GroupMember[]
  topicsNormalized   GroupTopic[]
  permissions        GroupPermission[]
  pins               GroupPin[]
  normalizedMessages GroupMessage[]

  @@index([type, createdAt(sort: Desc)])
  @@map("Groups")
}

model GroupMember {
  id          String   @id @default(uuid()) @db.Uuid
  groupId     String   @db.Uuid
  userId      String   @db.Uuid
  deleted     Boolean  @default(false)
  permissions Json     @default("{}")
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  group            Group                        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user             User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  topicPermissions GroupMemberTopicPermission[]

  @@unique([groupId, userId])
  @@index([userId])
  @@map("GroupMembers")
}

model GroupTopic {
  id        String   @id @default(uuid()) @db.Uuid
  groupId   String   @db.Uuid
  url       String   @db.VarChar(100)
  title     String   @db.VarChar(255)
  logo      String?  @db.Text
  defaults  Json     @default("{}")
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  group       Group                        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  permissions GroupMemberTopicPermission[]
  messages    GroupMessage[]
  pins        GroupPin[]

  @@unique([groupId, url])
  @@index([groupId])
  @@map("GroupTopics")
}

model GroupMemberTopicPermission {
  id          String @id @default(uuid()) @db.Uuid
  memberId    String @db.Uuid
  topicId     String @db.Uuid
  permissions Json   @default("{}")

  member GroupMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  topic  GroupTopic  @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([memberId, topicId])
  @@map("GroupMemberTopicPermissions")
}

model GroupPermission {
  id         String  @id @default(uuid()) @db.Uuid
  groupId    String  @db.Uuid
  userId     String? @db.Uuid
  permission String  @db.VarChar(100)
  value      Json    @default("true")

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId, permission])
  @@index([userId])
  @@map("GroupPermissions")
}

model GroupMessage {
  id        String   @id @default(uuid()) @db.Uuid
  groupId   String   @db.Uuid
  topicId   String?  @db.Uuid
  userId    String?  @db.Uuid
  message   String?  @db.Text
  payload   Json     @default("{}")
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  group Group       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  topic GroupTopic? @relation(fields: [topicId], references: [id], onDelete: Cascade)
  user  User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  pins  GroupPin[]

  @@index([groupId, createdAt])
  @@index([topicId, createdAt])
  @@map("GroupMessages")
}

model GroupPin {
  id         String   @id @default(uuid()) @db.Uuid
  groupId    String   @db.Uuid
  topicId    String?  @db.Uuid
  messageId  String?  @db.Uuid
  pinnedById String?  @db.Uuid
  createdAt  DateTime @default(now()) @db.Timestamptz(6)

  group    Group         @relation(fields: [groupId], references: [id], onDelete: Cascade)
  topic    GroupTopic?   @relation(fields: [topicId], references: [id], onDelete: Cascade)
  message  GroupMessage? @relation(fields: [messageId], references: [id], onDelete: Cascade)
  pinnedBy User?         @relation(fields: [pinnedById], references: [id], onDelete: SetNull)

  @@unique([groupId, messageId])
  @@index([topicId])
  @@map("GroupPins")
}

model Message {
  id        String      @id @default(uuid()) @db.Uuid
  pin       Boolean     @default(false)
  reply     String?     @db.Text
  user      String      @db.Text
  message   String?     @db.Text
  images    Json        @default("[]")
  audio     String?     @db.Text
  video     String?     @db.Text
  file      String?     @db.Text
  group     String      @map("group") @db.Text
  poll      Json        @default("{}")
  groups    Json        @default("[]")
  topic     String?     @db.Text
  topics    Json        @default("[]")
  views     Json        @default("[]")
  options   Json        @default("[]")
  type      MessageType @default(message)
  reactions Json        @default("[]")
  updatedAt DateTime    @updatedAt @db.Timestamptz(6)
  createdAt DateTime    @default(now()) @db.Timestamptz(6)

  groupRef Group? @relation(fields: [group], references: [url], onDelete: Cascade)

  @@index([group, createdAt(sort: Desc)])
  @@index([type, createdAt(sort: Desc)])
  @@map("Messages")
}
